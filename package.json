{
  "name": "zen-launcher",
  "productName": "ZEN Launcher",
  "version": "2.3.1",
  "releaseDate": "2026-11-06",
  "description": "![](./doc/thumbnail-01.png)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/main/domain/launcher/launcherFrame.test.js src/main/infrastructure/tray/appTray.test.js src/main/infrastructure/windows/foregroundFullscreen.test.js src/main/infrastructure/windows/masterMute.test.js",
    "build:win32": "electron-builder --win nsis --ia32 --publish never",
    "build:win64": "electron-builder --win nsis --x64 --publish never",
    "build:win": "electron-builder --win nsis --ia32 --x64 --publish never",
    "release:win": "electron-builder --win nsis --ia32 --x64 --publish always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JISU-YANG/NP-Launcher.git"
  },
  "author": "Noly-Poly",
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.0"
  },
  "build": {
    "appId": "com.jisuyang.zenlauncher",
    "artifactName": "${name}-${version}-setup-${arch}.${ext}",
    "files": [
      "**/*",
      "!dist/**",
      "!doc/**",
      "!**/*.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "JISU-YANG",
      "repo": "ZEN-Launcher",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseName": "v2.3.1",
      "releaseNotes": "런처를 고른 여백으로 다시 배치했습니다. 검색, 폴더, 이름, 설정은 사이드바에 있고 하단 바는 본문 아래에서 끝납니다.\n\n갤러리 이름은 마우스를 올렸을 때만 올라옵니다. 빈 칸은 평소에 보이지 않고, 마우스를 올리면 테두리와 +가 나타납니다."
    },
    "win": {
      "icon": "src/app/ZEN-Launcher.png",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZEN Launcher",
      "uninstallDisplayName": "ZEN Launcher",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-shutdown-command": "^2.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11"
  },
  "bugs": {
    "url": "https://github.com/JISU-YANG/NP-Launcher/issues"
  },
  "homepage": "https://github.com/JISU-YANG/NP-Launcher#readme"
}
