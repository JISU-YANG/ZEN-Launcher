{
  "name": "zen-launcher",
  "productName": "ZEN Launcher",
  "version": "2.1.0",
  "description": "![](./doc/thumbnail-01.png)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/main/domain/launcher/launcherFrame.test.js",
    "build:win32": "electron-builder --win portable --ia32",
    "build:win64": "electron-builder --win portable --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JISU-YANG/NP-Launcher.git"
  },
  "author": "Noly-Poly",
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.0"
  },
  "build": {
    "artifactName": "${name}-${version}_windows-${arch}.${ext}",
    "win": {
      "icon": "src/app/ZEN-Launcher.png",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "electron-shutdown-command": "^2.0.1",
    "electron-store": "^8.2.0"
  },
  "bugs": {
    "url": "https://github.com/JISU-YANG/NP-Launcher/issues"
  },
  "homepage": "https://github.com/JISU-YANG/NP-Launcher#readme"
}
