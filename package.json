{
  "name": "zen-launcher",
  "productName": "ZEN Launcher",
  "version": "2.2.0",
  "description": "![](./doc/thumbnail-01.png)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win32": "electron-builder --win nsis --ia32 --publish never",
    "build:win64": "electron-builder --win nsis --x64 --publish never",
    "build:win": "electron-builder --win nsis --ia32 --x64 --publish never",
    "release:win": "electron-builder --win nsis --ia32 --x64 --publish always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JISU-YANG/NP-Launcher.git"
  },
  "author": "Noly-Poly",
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.0"
  },
  "build": {
    "appId": "com.jisuyang.zenlauncher",
    "artifactName": "${name}-${version}-setup-${arch}.${ext}",
    "files": [
      "**/*",
      "!dist/**",
      "!doc/**",
      "!**/*.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "JISU-YANG",
      "repo": "ZEN-Launcher",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseName": "v2.2.0",
      "releaseNotes": "Windows 배포를 NSIS 설치형으로 바꾸고 GitHub Releases 자동 업데이트를 추가했습니다.\n\n환경설정 단축키 탭에서 다른 앱이 전체 화면일 때의 동작을 고를 수 있습니다.\n- Ctrl+Space를 해당 앱에 넘기는 옵션은 기본 꺼짐입니다.\n- 애니메이션을 멈추고 화면 갱신을 낮추는 자원 절약은 기본 최소화입니다.\n\n이전 portable 실행 파일을 쓰던 경우에는 설치 파일을 한 번 설치해야 이후 자동 업데이트가 이어집니다."
    },
    "win": {
      "icon": "src/app/ZEN-Launcher.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZEN Launcher",
      "uninstallDisplayName": "ZEN Launcher",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-shutdown-command": "^2.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11"
  },
  "bugs": {
    "url": "https://github.com/JISU-YANG/NP-Launcher/issues"
  },
  "homepage": "https://github.com/JISU-YANG/NP-Launcher#readme"
}
